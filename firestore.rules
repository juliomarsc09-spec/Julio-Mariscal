rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShardDocId(id) {
      return isValidId(id) && id.matches('^shard_[0-9]{3}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'juliomarsc09@gmail.com'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'unit', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'unit', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role is string && data.role in ['officer', 'admin']
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.createdAt is timestamp;
    }

    function isValidSharedMeta(data) {
      return data.keys().hasAll(['shardVersion', 'shardCount', 'totalRecords', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['shardVersion', 'shardCount', 'totalRecords', 'updatedBy', 'updatedAt'])
        && data.shardVersion is int && data.shardVersion >= 1 && data.shardVersion <= 1000000000
        && data.shardCount is int && data.shardCount >= 0 && data.shardCount <= 500
        && data.totalRecords is int && data.totalRecords >= 0 && data.totalRecords <= 225000
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidSharedBranding(data) {
      return data.keys().hasAll(['customLogo', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['customLogo', 'updatedBy', 'updatedAt'])
        && data.customLogo is string && data.customLogo.size() <= 350000
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidSharedDatasetShard(data) {
      return data.keys().hasAll(['index', 'recordCount', 'records', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['index', 'recordCount', 'records', 'updatedBy', 'updatedAt'])
        && data.index is int && data.index >= 0 && data.index <= 500
        && data.recordCount is int && data.recordCount >= 0 && data.recordCount <= 450
        && data.records is list && data.records.size() <= 450
        && (data.records.size() == 0 || data.records[0] is map)
        && data.recordCount == data.records.size()
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidSharedWatchlists(data) {
      return data.keys().hasAll(['commodityWatchlist', 'countryWatchlist', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['commodityWatchlist', 'countryWatchlist', 'updatedBy', 'updatedAt'])
        && data.commodityWatchlist is list && data.commodityWatchlist.size() <= 500
        && (data.commodityWatchlist.size() == 0 || data.commodityWatchlist[0] is map)
        && data.countryWatchlist is list && data.countryWatchlist.size() <= 500
        && (data.countryWatchlist.size() == 0 || data.countryWatchlist[0] is map)
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidSharedCompliance(data) {
      return data.keys().hasAll(['scores', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['scores', 'updatedBy', 'updatedAt'])
        && data.scores is map && data.scores.keys().size() <= 5000
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidSharedContacts(data) {
      return data.keys().hasAll(['contacts', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['contacts', 'shardCount', 'totalContacts', 'updatedBy', 'updatedAt'])
        && data.contacts is map && data.contacts.keys().size() <= 5000
        && (!('shardCount' in data) || (data.shardCount is int && data.shardCount >= 0 && data.shardCount <= 200))
        && (!('totalContacts' in data) || (data.totalContacts is int && data.totalContacts >= 0 && data.totalContacts <= 100000))
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidSharedContactShard(data) {
      return data.keys().hasAll(['index', 'contactCount', 'contacts', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['index', 'contactCount', 'contacts', 'updatedBy', 'updatedAt'])
        && data.index is int && data.index >= 0 && data.index <= 200
        && data.contactCount is int && data.contactCount >= 0 && data.contactCount <= 500
        && data.contacts is map && data.contacts.keys().size() <= 500
        && data.contactCount == data.contacts.keys().size()
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidSharedLogs(data) {
      return data.keys().hasAll(['logs', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['logs', 'updatedBy', 'updatedAt'])
        && data.logs is list && data.logs.size() <= 200
        && (data.logs.size() == 0 || data.logs[0] is map)
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidWatchlistCloudItem(data, itemId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'kind', 'targetName', 'priorityLevel',
          'reason', 'officerName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'kind', 'targetName', 'priorityLevel',
          'reason', 'officerName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && isValidId(data.ownerId)
        && data.kind is string && data.kind in ['COMMODITY', 'COUNTRY']
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 150
        && data.priorityLevel is string && data.priorityLevel in ['LOW', 'MEDIUM', 'HIGH']
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
        && data.officerName is string && data.officerName.size() >= 1 && data.officerName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuarantineCloudNote(data, noteId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'companyName', 'category',
          'activity', 'note', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'companyName', 'category',
          'activity', 'note', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == noteId
        && isValidId(data.ownerId)
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 150
        && data.category is string && data.category in ['HEWAN', 'IKAN', 'TUMBUHAN']
        && data.activity is string && data.activity in ['IMPOR', 'EKSPOR', 'DOMESTIK MASUK', 'DOMESTIK KELUAR']
        && data.note is string && data.note.size() >= 1 && data.note.size() <= 600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && (incoming().role == 'officer' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'unit', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Master Gate Split PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isValidId(userId)
          && (isOwner(userId) || isAdmin())
          && resource.data.uid == userId;

        allow create: if isValidId(userId) && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId) && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.uid is string;
      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminGrant(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Shared BBKHIT Cloud Store (AI Studio <-> Published Unified Persistence Without Login, Monotonic Version Lock)
    match /shared_meta/{docId} {
      allow get: if isValidId(docId) && docId == 'current';
      allow list: if false;
      allow create: if isValidId(docId)
        && docId == 'current'
        && isValidSharedMeta(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(docId)
        && docId == 'current'
        && isValidSharedMeta(incoming())
        && incoming().updatedAt == request.time
        && incoming().shardVersion > existing().shardVersion
        && incoming().diff(existing()).affectedKeys().hasOnly(['shardVersion', 'shardCount', 'totalRecords', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /shared_branding/{docId} {
      allow get: if isValidId(docId) && docId == 'current';
      allow list: if false;
      allow create: if isValidId(docId)
        && docId == 'current'
        && isValidSharedBranding(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(docId)
        && docId == 'current'
        && isValidSharedBranding(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['customLogo', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /shared_dataset_shards/{shardId} {
      allow get: if isValidShardDocId(shardId);
      allow list: if false;
      allow create: if isValidShardDocId(shardId)
        && isValidSharedDatasetShard(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidShardDocId(shardId)
        && isValidSharedDatasetShard(incoming())
        && incoming().index == existing().index
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['recordCount', 'records', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /shared_watchlists/{docId} {
      allow get: if isValidId(docId) && docId == 'current';
      allow list: if false;
      allow create: if isValidId(docId)
        && docId == 'current'
        && isValidSharedWatchlists(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(docId)
        && docId == 'current'
        && isValidSharedWatchlists(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['commodityWatchlist', 'countryWatchlist', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /shared_compliance/{docId} {
      allow get: if isValidId(docId) && docId == 'current';
      allow list: if false;
      allow create: if isValidId(docId)
        && docId == 'current'
        && isValidSharedCompliance(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(docId)
        && docId == 'current'
        && isValidSharedCompliance(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['scores', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /shared_contacts/{docId} {
      allow get: if isValidId(docId) && docId == 'current';
      allow list: if false;
      allow create: if isValidId(docId)
        && docId == 'current'
        && isValidSharedContacts(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(docId)
        && docId == 'current'
        && isValidSharedContacts(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['contacts', 'shardCount', 'totalContacts', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /shared_contact_shards/{shardId} {
      allow get: if isValidShardDocId(shardId);
      allow list: if false;
      allow create: if isValidShardDocId(shardId)
        && isValidSharedContactShard(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidShardDocId(shardId)
        && isValidSharedContactShard(incoming())
        && incoming().index == existing().index
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['contactCount', 'contacts', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /shared_logs/{docId} {
      allow get: if isValidId(docId) && docId == 'current';
      allow list: if false;
      allow create: if isValidId(docId)
        && docId == 'current'
        && isValidSharedLogs(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(docId)
        && docId == 'current'
        && isValidSharedLogs(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['logs', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /watchlist_items/{itemId} {
      allow get: if isValidId(itemId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isValidId(itemId)
        && isSignedIn()
        && isValidWatchlistCloudItem(incoming(), itemId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(itemId)
        && isSignedIn()
        && isValidWatchlistCloudItem(incoming(), itemId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['priorityLevel', 'reason', 'officerName', 'updatedAt'])
          )
        );

      allow delete: if isValidId(itemId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /quarantine_notes/{noteId} {
      allow get: if isValidId(noteId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isValidId(noteId)
        && isSignedIn()
        && isValidQuarantineCloudNote(incoming(), noteId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(noteId)
        && isSignedIn()
        && isValidQuarantineCloudNote(incoming(), noteId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'category', 'activity', 'updatedAt'])
          )
        );

      allow delete: if isValidId(noteId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Connection probe path (used by boot getDocFromServer check)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
    }
  }
}
