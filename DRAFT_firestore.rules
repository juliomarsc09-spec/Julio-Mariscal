rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'juliomarsc09@gmail.com'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'unit', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'unit', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role is string && data.role in ['officer', 'admin']
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.createdAt is timestamp;
    }

    function isValidWatchlistCloudItem(data, itemId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'kind', 'targetName', 'priorityLevel',
          'reason', 'officerName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'kind', 'targetName', 'priorityLevel',
          'reason', 'officerName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && isValidId(data.ownerId)
        && data.kind is string && data.kind in ['COMMODITY', 'COUNTRY']
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 150
        && data.priorityLevel is string && data.priorityLevel in ['LOW', 'MEDIUM', 'HIGH']
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
        && data.officerName is string && data.officerName.size() >= 1 && data.officerName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuarantineCloudNote(data, noteId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'companyName', 'category',
          'activity', 'note', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'companyName', 'category',
          'activity', 'note', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == noteId
        && isValidId(data.ownerId)
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 150
        && data.category is string && data.category in ['HEWAN', 'IKAN', 'TUMBUHAN']
        && data.activity is string && data.activity in ['IMPOR', 'EKSPOR', 'DOMESTIK MASUK', 'DOMESTIK KELUAR']
        && data.note is string && data.note.size() >= 1 && data.note.size() <= 600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && (incoming().role == 'officer' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'unit', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Master Gate Split PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isValidId(userId)
          && (isOwner(userId) || isAdmin())
          && resource.data.uid == userId;

        allow create: if isValidId(userId) && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId) && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isOwner(userId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.uid is string;
      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminGrant(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /watchlist_items/{itemId} {
      allow get: if isValidId(itemId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isValidId(itemId)
        && isSignedIn()
        && isValidWatchlistCloudItem(incoming(), itemId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(itemId)
        && isSignedIn()
        && isValidWatchlistCloudItem(incoming(), itemId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['priorityLevel', 'reason', 'officerName', 'updatedAt'])
          )
        );

      allow delete: if isValidId(itemId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /quarantine_notes/{noteId} {
      allow get: if isValidId(noteId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isValidId(noteId)
        && isSignedIn()
        && isValidQuarantineCloudNote(incoming(), noteId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(noteId)
        && isSignedIn()
        && isValidQuarantineCloudNote(incoming(), noteId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'category', 'activity', 'updatedAt'])
          )
        );

      allow delete: if isValidId(noteId)
        && isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Connection probe path (used by boot getDocFromServer check)
    match /test/{docId} {
      allow get: if isValidId(docId) && false;
    }
  }
}
